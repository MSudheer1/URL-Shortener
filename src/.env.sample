# ⚙️ App Settings
APP_SECRET_KEY=your-secret-key
APP_DEBUG=true
APP_DEFAULT_DOMAIN=your-default-domain.com  # e.g. shorturl.com or 127.0.0.1:8000

# 🐘 PostgreSQL Settings
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name
DB_HOST=localhost  # or your-db.rds.amazonaws.com
DB_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# 🧠 Redis Settings
REDIS_HOST=localhost  # or your-redis-host.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password  # Optional
REDIS_DATABASE=0
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true
REDIS_USE_TLS=false

# 📧 Mail Settings (Mailtrap or Mailgun)
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=no-reply@yourdomain.com
